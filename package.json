{
    "name":  "dsh-cyui",
    "version":  "1.0.3",
    "description":  "CYUI — 雨夜书桌氛围主题 for DeepSeek Harness：可导入/缩放/压暗/磨砂的背景层 + 来电式启幕 + 赛博数据流。",
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./client":  "./lib/client.js",
                    "./icon":  "./icon.png",
                    "./locale/*.json":  "./locale/*.json",
                    "./package.json":  "./package.json"
                },
    "keywords":  [
                     "dsh-plugin",
                     "dsh",
                     "deepseek-harness",
                     "theme",
                     "cyui",
                     "wallpaper"
                 ],
    "files":  [
                  "lib/client.js",
                  "lib/index.js",
                  "cordis.patch.yml",
                  "README.md",
                  "LICENSE",
                  "icon.png",
                  "locale/*.json"
              ],
    "license":  "MIT",
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "inject":  [

                                          ]
                           }
            },
    "author":  {
                   "name":  "Lygus-496"
               },
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/Lygus-496/dsh-cyui"
                   },
    "homepage":  "https://github.com/Lygus-496/dsh-cyui#readme",
    "icon":  "./icon.png"
}