{
    "name":  "dsh-cyui",
    "version":  "1.1.0",
    "description":  "给 DeepSeek Harness 的窗口换一个房间：可导入的背景层（缩放/填充/压暗/磨砂）、指针暖光、赛博数据流、来电式启幕。包内不含图片。",
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./client":  "./lib/client.js",
                    "./icon":  "./icon.png",
                    "./locale/*.json":  "./locale/*.json",
                    "./package.json":  "./package.json"
                },
    "keywords":  [
                     "dsh-plugin",
                     "dsh",
                     "deepseek-harness",
                     "theme",
                     "cyui",
                     "wallpaper"
                 ],
    "files":  [
                  "lib/client.js",
                  "lib/index.js",
                  "cordis.patch.yml",
                  "README.md",
                  "LICENSE",
                  "icon.png",
                  "locale/*.json"
              ],
    "license":  "MIT",
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "inject":  [

                                          ]
                           }
            },
    "author":  {
                   "name":  "Lygus-496"
               },
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/Lygus-496/dsh-cyui"
                   },
    "homepage":  "https://github.com/Lygus-496/dsh-cyui#readme",
    "icon":  "./icon.png"
}